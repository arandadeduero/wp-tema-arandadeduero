<?xml version="1.0"?>
<ruleset name="Aranda de Duero Theme Coding Standards">
	<!-- See https://github.com/squizlabs/PHP_CodeSniffer/wiki/Annotated-ruleset.xml -->
	<!-- See https://github.com/WordPress/WordPress-Coding-Standards -->
	<!-- See https://github.com/PHPCompatibility/PHPCompatibilityWP -->
	<!-- Note: WPTRT/WPThemeReview is not used — it has not been updated for WPCS 3.x. -->

	<!-- Set a description for this ruleset. -->
	<description>Modern WordPress theme coding standards for Aranda de Duero.</description>

	<!--
	#############################################################################
	COMMAND LINE ARGUMENTS
	https://github.com/squizlabs/PHP_CodeSniffer/wiki/Annotated-ruleset.xml
	#############################################################################
	-->

	<!-- Pass some flags to PHPCS. -->
	<arg value="ps"/>
	<arg name="colors"/>

	<!-- Strip the filepaths down to the relevant bit. -->
	<arg name="basepath" value="./"/>

	<!-- Check up to 8 files simultaneously. -->
	<arg name="parallel" value="8"/>

	<!-- Only check PHP files. -->
	<arg name="extensions" value="php"/>

	<!-- Check all files in this directory and below. -->
	<file>.</file>

	<!-- Exclude patterns. -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>
	<exclude-pattern>*.min.php</exclude-pattern>
	<!-- PHPStan-only type stubs: deliberately redeclare third-party/WP-core
	     function names and aren't part of the theme's runtime code. -->
	<exclude-pattern>/phpstan-stubs/*</exclude-pattern>

	<!--
	#############################################################################
	USE THE WordPress AND Theme Review RULESET
	#############################################################################
	-->

	<!-- Include WordPress coding standards -->
	<rule ref="WordPress">
		<!-- This rule does not apply since the prefix should be unique to this theme. -->
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed"/>
		<!--
		Full PHPDoc completeness (file/function comments, inline-comment
		punctuation) has never been this codebase's convention, and
		retrofitting it across ~70 files now is disproportionate to the
		value for a small municipal theme. Security, correctness and
		WP-specific sniffs stay on; this only drops doc-formatting nitpicks.
		-->
		<exclude name="Squiz.Commenting"/>
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
	</rule>

	<!--
	#############################################################################
	SNIFF SPECIFIC CONFIGURATION
	#############################################################################
	-->

	<!-- Verify that the text_domain is set correctly. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="aranda-de-duero"/>
			</property>
		</properties>
	</rule>

	<!-- Allow for theme specific exceptions to file naming. -->
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="is_theme" value="true"/>
		</properties>
	</rule>

	<!-- Set minimum supported WordPress version. -->
	<config name="minimum_supported_wp_version" value="5.0"/>

	<!-- Configure array formatting rules. -->
	<rule ref="WordPress.Arrays.MultipleStatementAlignment">
		<properties>
			<property name="exact" value="false"/>
			<property name="alignMultilineItems" value="!=100"/>
			<property name="ignoreNewlines" value="false"/>
		</properties>
	</rule>

	<!--
	Verify that all globals in the global namespace are prefixed.
	Scoped out of page/archive templates: this sniff also flags ordinary
	top-level $variables (loop counters, $query, $args...), which is the
	normal and expected way to write a WordPress template — there's
	nothing "global" about them in the sense this sniff is meant to guard
	against (naming collisions between plugins/themes). It still applies
	to functions.php and inc/, where real global functions/constants live.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="aranda_de_duero"/>
			</property>
		</properties>
		<exclude-pattern>*/page-*.php</exclude-pattern>
		<exclude-pattern>*/page.php</exclude-pattern>
		<exclude-pattern>*/taxonomy-*.php</exclude-pattern>
		<exclude-pattern>*/single-*.php</exclude-pattern>
		<exclude-pattern>*/single.php</exclude-pattern>
		<exclude-pattern>*/archive.php</exclude-pattern>
		<exclude-pattern>*/search.php</exclude-pattern>
		<exclude-pattern>*/searchform.php</exclude-pattern>
		<exclude-pattern>*/comments.php</exclude-pattern>
		<exclude-pattern>*/index.php</exclude-pattern>
		<exclude-pattern>*/404.php</exclude-pattern>
		<exclude-pattern>*/header.php</exclude-pattern>
		<exclude-pattern>*/footer.php</exclude-pattern>
		<exclude-pattern>*/template-parts/*</exclude-pattern>
	</rule>

	<!--
	#############################################################################
	USE PHPCompatibility RULESET
	#############################################################################
	-->

	<!-- Check for PHP 7.4+ compatibility -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

</ruleset>
