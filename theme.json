{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "primary",
					"color": "#005B99",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#e8f0f7",
					"name": "Secondary"
				},
				{
					"slug": "dark",
					"color": "#222222",
					"name": "Dark"
				},
				{
					"slug": "light",
					"color": "#ffffff",
					"name": "Light"
				},
				{
					"slug": "accent",
					"color": "#b50101",
					"name": "Accent"
				}
			],
			"custom": true,
			"customGradient": false,
			"defaultPalette": false
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "Outfit, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, sans-serif",
					"slug": "outfit",
					"name": "Outfit",
					"fontFace": [
						{
							"fontFamily": "Outfit",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./css/fonts/outfit-variable-latin-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Outfit",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./css/fonts/outfit-variable-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, sans-serif",
					"slug": "system",
					"name": "System Font"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "normal",
					"size": "1rem",
					"name": "Normal"
				},
				{
					"slug": "medium",
					"size": "1.25rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.5rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "2rem",
					"name": "X-Large"
				}
			],
			"customFontSize": true
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"em",
				"%"
			],
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"slug": "20",
					"size": "0.5rem",
					"name": "XS"
				},
				{
					"slug": "30",
					"size": "1rem",
					"name": "S"
				},
				{
					"slug": "40",
					"size": "1.5rem",
					"name": "M"
				},
				{
					"slug": "50",
					"size": "2.5rem",
					"name": "L"
				},
				{
					"slug": "60",
					"size": "4rem",
					"name": "XL"
				}
			]
		},
		"layout": {
			"contentSize": "1140px",
			"wideSize": "1320px"
		}
	},
	"styles": {
		"color": {
			"background": "#ffffff",
			"text": "#222222"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--outfit)",
			"fontSize": "var(--wp--preset--font-size--normal)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": "3px"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--light)"
				},
				"typography": {
					"fontWeight": "600"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--primary)",
						"width": "4px"
					}
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--40)"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--secondary)"
				}
			}
		}
	}
}
