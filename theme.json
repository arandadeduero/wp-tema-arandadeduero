{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "primary",
					"color": "#005B99",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#e8f0f7",
					"name": "Secondary"
				},
				{
					"slug": "dark",
					"color": "#222222",
					"name": "Dark"
				},
				{
					"slug": "light",
					"color": "#ffffff",
					"name": "Light"
				},
				{
					"slug": "accent",
					"color": "#b50101",
					"name": "Accent"
				}
			],
			"custom": true,
			"customGradient": false,
			"defaultPalette": false
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, sans-serif",
					"slug": "system",
					"name": "System Font"
				}
			],
			"fontSizes": [
				{ "slug": "small",        "size": "0.875rem", "name": "Small" },
				{ "slug": "normal",       "size": "1rem",     "name": "Normal" },
				{ "slug": "medium",       "size": "1.25rem",  "name": "Medium" },
				{ "slug": "large",        "size": "1.5rem",   "name": "Large" },
				{ "slug": "x-large",      "size": "2rem",     "name": "X-Large" }
			],
			"customFontSize": true
		},
		"spacing": {
			"units": [ "px", "rem", "em", "%" ]
		},
		"layout": {
			"contentSize": "1140px",
			"wideSize": "1320px"
		}
	},
	"styles": {
		"color": {
			"background": "#ffffff",
			"text": "#222222"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--normal)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } }
		}
	}
}
